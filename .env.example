# Model selection: gemini | ollama | llama | openai | bedrock | nova
# gemini = Google Gemini API (GEMINI_API_KEY)
# ollama = Ollama Cloud (https://ollama.com) or a local Ollama server
# llama  = Meta Llama API via Strands' native LlamaAPIModel
# openai = any OpenAI-compatible Llama host (OpenRouter, Together, Groq, ...)
CS_AGENT_MODEL_PROVIDER=gemini

# Optional explicit model id. Leave blank to use the provider default.
# Gemini:       gemini-3.5-flash, gemini-2.5-flash, gemini-2.5-pro, ...
# Ollama Cloud: gpt-oss:120b, qwen3-coder:480b, gemma4:31b, ...
# Ollama local: qwen3.5:9b, llama3.1
# Nova:         amazon.nova-pro-v1:0
CS_AGENT_MODEL_ID=

# API keys. Never commit a real key.
# Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Ollama Cloud key: https://ollama.com/settings/keys
OLLAMA_API_KEY=
# Llama API / OpenAI-compatible key
LLAMA_API_KEY=

# Ollama host: https://ollama.com for Ollama Cloud, http://localhost:11434 local
CS_AGENT_OLLAMA_HOST=http://localhost:11434

# Base URL for CS_AGENT_MODEL_PROVIDER=openai.
CS_AGENT_BASE_URL=

# Conversation persistence
CS_AGENT_SESSION_ID=customer-session-001
CS_AGENT_SESSION_DIR=./sessions

# Per-invocation tool-call cap
CS_AGENT_MAX_TOOL_CALLS=5

# Feature toggles (true/false)
CS_AGENT_ENABLE_SKILLS=true
CS_AGENT_ENABLE_STEERING=true
CS_AGENT_ENABLE_RATE_LIMIT=true
CS_AGENT_ENABLE_MULTI_AGENT=true

# AWS region used by Bedrock / AgentCore
AWS_REGION=us-east-1
